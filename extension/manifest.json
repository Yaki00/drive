{
  "manifest_version": 3,
  "name": "APS Tools Bookmarks",
  "version": "1.0.0",
  "description": "Add the current page or import browser bookmarks into APS Tools.",
  "permissions": ["bookmarks", "storage", "activeTab", "tabs"],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "action": {
    "default_title": "APS Tools Bookmarks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js"
  }
}
